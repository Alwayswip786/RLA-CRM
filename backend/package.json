    "@types/passport-google-oauth20": "^2.0.17",
    "@types/streamifier": "^0.1.2",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
